# ── Contab — variabile de mediu (exemplu). Copiază în .env și completează. ──
# .env este chmod 600 și gitignored; NU comite secrete reale.

# ── Reverse proxy ──
# Implicit „loopback": aplicația are încredere doar în proxy-ul local (nginx pe 127.0.0.1)
# pentru X-Forwarded-For/Proto. Schimbă DOAR dacă ai alt lanț de proxy (ex. TRUST_PROXY=2
# pentru două hop-uri, sau o subrețea CIDR). NU pune „true" — permite falsificarea IP-ului
# și ocolirea blocării anti-brute-force.
# TRUST_PROXY=loopback

# ── Logging ──
# CONTAB_LOG_LEVEL=info   # debug | info | warn | error (implicit info)
# CONTAB_LOG_JSON=1       # emite loguri JSON (o linie/eveniment) pentru agregare masinala;
#                         # implicit lizibil pentru `pm2 logs`. Fiecare eroare 5xx are un
#                         # reqId (si antetul X-Request-Id) pentru corelare cerere<->log.

# ── Baza de date ──
# CONTAB_DB_DRIVER=sqlite   # 'pg' (PostgreSQL), 'sqlite' (implicit) sau 'json' (vechi, rollback rapid)
# PostgreSQL (când CONTAB_DB_DRIVER=pg): implicit se conectează pe socketul local
# /var/run/postgresql cu autentificare peer (rolul = utilizatorul OS) și baza 'contab'.
# CONTAB_PG_URL=postgres://user:parola@host:5432/contab   # override explicit (ex. bază remote)
# PGDATABASE=contab         # numele bazei (când nu folosești CONTAB_PG_URL)
# La orice driver relațional se păstrează o oglindă JSON în data/db.json (backup + rollback).

# Extragere AI din documente (opțional). Cu ambele chei prezente, Anthropic are prioritate;
# comută explicit cu CONTAB_AI_PROVIDER. Modelele sunt per furnizor (un câmp partajat ar
# trimite id de model Claude către OpenAI).
ANTHROPIC_API_KEY=
# Implicit: claude-opus-5 (src/aiExtractor.js). Linia de mai jos e COMENTATĂ deliberat — un model
# scris aici bate implicitul din cod fără să se vadă, și exact așa ajunseseră codul, acest fișier
# și producția să numească trei modele diferite. Decomentează doar ca să alegi altceva.
# CONTAB_AI_MODEL=claude-sonnet-5
# OPENAI_API_KEY=
# CONTAB_AI_PROVIDER=anthropic     # sau openai — setarea explicită bate prezența cheilor
# CONTAB_AI_MODEL_OPENAI=gpt-4.1-mini
# CONTAB_AI_DAILY_LIMIT=200        # extrageri AI pe zi per utilizator (fiecare apel costă)
# CONTAB_AI_DAILY_LIMIT_DEMO=10    # limita contului public „demo"

# ── Parole: verificare de compromitere (HaveIBeenPwned, k-anonimitate) ──
# La alegerea unei parole (înscriere/resetare/invitație/schimbare) se verifică dacă apare în
# liste publice de parole compromise, trimițând DOAR primele 5 caractere din SHA1 (fail-open:
# dacă serviciul e indisponibil, parola e permisă). Dezactivează pe instalări fără internet.
# CONTAB_HIBP=0                    # 0 = dezactivează verificarea HIBP (implicit: activ)
# CONTAB_HIBP_TIMEOUT_MS=2500      # timeout pentru apelul HIBP (fail-open la depășire)

# ── Localizarea IP-urilor în panoul „Cine accesează aplicația" (admin) ──
# Adresele IP ale autentificărilor se trimit unui serviciu extern ca să afle țara/orașul.
# E un SUBÎMPUTERNICIT: declarat în public/confidentialitate.html și în Anexa 2 din public/dpa.html,
# cu o poartă în test/run/porti.js care pică dacă modulul e folosit fără să fie declarat.
# Adresele private nu pleacă niciodată; rezultatul se ține în cache pe IP (30 de zile, în memorie).
# Eșecul nu e fatal — panoul se afișează fără coloana de locație.
# CONTAB_GEOIP_URL=https://ipwho.is/   # furnizorul (se adaugă IP-ul la sfârșit)
# CONTAB_GEOIP_TIMEOUT_MS=4000         # timeout per interogare
# CONTAB_ACCESS_MAX=300                # câte autentificări se întorc în panou (cele mai recente)

# ── Accesările site-ului (agregate pe IP, src/visitors.js) ──
# Fiecare adresă care atinge site-ul, INCLUSIV vizitatorii fără cont. Un rând per adresă, nu per
# cerere; calea cererii nu scrie în bază (job periodic la 60 s, doar dacă s-a schimbat ceva).
# Declarate în public/confidentialitate.html, cu retenție automată.
# CONTAB_VISITORS_MAX=2000             # câte adrese distincte se rețin (la depășire iese cea mai veche)
# CONTAB_VISITORS_DAYS=30              # retenție, în zile (peste asta, rândul se șterge singur)

# ── Stripe — abonamente / plăți online (opțional) ──
# Fără STRIPE_SECRET_KEY, plățile online sunt DEZACTIVATE, iar aplicația cade grațios
# pe activarea manuală a planurilor (de către admin). Vezi STRIPE-SETUP.md.
STRIPE_SECRET_KEY=              # sk_test_... (test) / sk_live_... (producție)
STRIPE_WEBHOOK_SECRET=          # whsec_... (Dashboard Stripe → Developers → Webhooks)
STRIPE_PRICE_START=             # price_... (produsul „Start", preț recurent lunar)
STRIPE_PRICE_PRO=               # price_... (produsul „Pro")
APP_URL=https://contabo.space   # URL-ul aplicației, pentru redirect success/cancel

# ── Backup offsite (scripts/backup.js, cron zilnic 03:30) ──
# Arhiva completă (db.json + contab.sqlite + uploads/) se trimite în afara serverului.
CONTAB_BACKUP_EMAIL_TO=         # destinatar email pentru arhiva zilnică (gol = fără email)
RESEND_API_KEY=                 # cheia Resend pentru trimiterea emailului
# RCLONE_REMOTE=b2:bucket/contab   # alternativă/completare: copiere cu rclone (peste 20MB obligatoriu)
#
# ── Copie offsite pe STOCARE OBIECT (S3-compatibil) — destinația RECOMANDATĂ ──
# E-mailul are limită de dimensiune și trece datele fiscale printr-o cutie poștală terță.
# Semnare AWS SigV4 nativă (fără rclone, fără dependențe). Toate patru sunt obligatorii —
# lipsa oricăreia înseamnă „neconfigurat", iar urcarea nici nu se încearcă.
# Verifică setarea IMEDIAT, fără să aștepți cron-ul: `npm run offsite-check`
# CONTAB_OFFSITE_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
# CONTAB_OFFSITE_BUCKET=contab-backup    # bucket PRIVAT, cu versionare/retenție dacă se poate
# CONTAB_OFFSITE_KEY=                    # access key, limitată doar la bucketul de mai sus
# CONTAB_OFFSITE_SECRET=                 # secret key
# CONTAB_OFFSITE_REGION=us-east-1        # opțional
# CONTAB_OFFSITE_PREFIX=contab           # opțional, prefixul obiectelor în bucket
# CONTAB_BACKUP_KEEP=30            # câte copii db-*.json se păstrează local
# CONTAB_BACKUP_KEEP_FULL=14       # câte arhive full-*.zip se păstrează local
# CONTAB_BACKUP_KEEP_ADHOC=10      # câte backup-uri ad-hoc db.json.bak-* se păstrează în data/
# CONTAB_BACKUP_KEEP_PRE_RESTORE=10  # câte copii pre-restore-*.json se păstrează (se fac automat
#                                    # înaintea fiecărei restaurări, ca să poți da înapoi)

# ── Praguri de alertă (joburile din src/jobs.js) ──
# CONTAB_PERSIST_LAG_MS=60000   # persist-watch: de cât timp poate aștepta necomisă o scriere în
#                               # coada pg înainte de alertă. Scrierile în așteptare trăiesc doar
#                               # în RAM — o coadă care nu se golește e drumul spre plafonul pm2.
# CONTAB_PERSIST_FAILS=3        # ...sau câte eșecuri consecutive de persistare declanșează alerta
# CONTAB_LAG_WARN_MS=250        # lag-watch: cât are voie să stea blocată bucla de evenimente
#                               # înainte de alertă. Aplicația e UN SINGUR proces, deci o bucată de
#                               # muncă sincronă (scrypt la login, pg_dump + zip la backup, un
#                               # raport mare) oprește TOATE cererile. În durata pe rută asta apare
#                               # ca „totul a fost lent atunci", fără vinovat — lagul e măsura care
#                               # separă o cerere lentă în sine de una blocată în spatele alteia.
#                               # Se compară cu vârful ferestrei, nu cu media: un blocaj de o
#                               # secundă într-un minut liniștit lasă media aproape neatinsă.
# CONTAB_MEM_WARN_MB=           # prag de avertizare RSS (implicit 70% din CONTAB_PM2_MAX_MB)
# CONTAB_PM2_MAX_MB=1024        # plafonul `max_memory_restart` din ecosystem.config.js. Nu îl
#                               # citim din pm2: dacă schimbi plafonul acolo, schimbă-l ȘI aici,
#                               # altfel avertizarea „înainte de plafon" se raportează la altul.

# ── Diverse ──
# CONTAB_JSON_MIRROR=1          # 0 = oprește oglinda db.json scrisă lângă baza sqlite/pg. Oglinda
#                               # e fișierul pe care îl copiază backupul — nu o opri în producție.
# CONTAB_ANAF_BACKOFF_MS=500    # pauza între reîncercările GET către ANAF (anafFetch)

# ── Expunere în producție ──
# HOST=127.0.0.1            # producție: doar loopback — accesul public vine prin nginx (HTTPS)
# CONTAB_FORCE_HTTPS=1      # refuză/redirecționează HTTP-ul venit din exterior
# CONTAB_RATE_IMPORT=10     # importuri de arhive ZIP pe oră per utilizator (RAM-intensive)
# CONTAB_RATE_CLIENT_ERR=30 # raportări de erori JavaScript din browser, pe oră per IP
#                           # (POST /api/client-error). Ruta e PUBLICĂ deliberat: o eroare pe
#                           # ecranul de login e exact cea care altfel nu se află — utilizatorii
#                           # pleacă fără să reclame. Peste plafon răspunsul rămâne 204, ca
#                           # clientul să nu reîncerce. Erorile se văd în /api/metrics
#                           # (admin) → `clientErrors`, agregate pe semnătură.
# CONTAB_BACKUP_KEY=            # cheie AES pentru copiile offsite criptate (openssl rand -base64 48).
#                               # ABSENTĂ = arhiva pleacă în CLAR; backupul avertizează acum explicit.
#                               # Cheia NU se ține lângă backup (alt furnizor, alt loc). Procedura
#                               # completă de activare: docs/rulare.md, secțiunea RTO / RPO.
# CONTAB_SECRETS_KEY=           # 64 hex (openssl rand -hex 32) — criptează parola SMTP și
#                               # credențialele SPV în bază; ține cheia DOAR aici, nu în backup.
# CONTAB_SECRETS_KEY_OLD=       # doar în timpul rotației de cheie (vezi src/secretbox.js)
# CONTAB_AUTH_SECRET=           # 64 hex (openssl rand -hex 32) — cheia de semnare a
#                               # cookie-urilor de sesiune. Setat aici, e AUTORITATEA (nu stă
#                               # în bază/backup, nu e scriabil din aplicație). Schimbarea lui
#                               # invalidează sesiunile active (utilizatorii se re-loghează).
# CONTAB_AUDIT_DIR=            # volum/director separat pentru jurnalul de audit durabil (implicit data/audit)
# CONTAB_AUDIT_MAX=20000   # câte înregistrări de audit se păstrează în baza vie (proba durabilă
#                          # e în backupul zilnic offsite + exportul CSV /csv/audit)
# CONTAB_MESSAGES_MAX=500  # câte mesaje se păstrează PER CONVERSAȚIE de suport. Spre deosebire de
#                          # audit, mesajele NU au probă durabilă pe disc: tăierea chiar pierde
#                          # istoric, de aceea plafonul e generos. Per conversație, nu global —
#                          # altfel o conversație zgomotoasă ar evacua istoricul tuturor.

# ── Pachetul Windows (scripts/pachet-windows.sh) ──
# Construiește arhiva pe care utilizatorii o descarcă din aplicație (Setări → Conexiuni & unelte)
# și o rulează local pe PC. Rezultatul: public/descarcari/Contabo-Windows.zip + pachet.json.
# CONTAB_PACHET_NODE=22.23.1          # versiunea de Node inclusă (implicit: cea care rulează)
# CONTAB_PACHET_CACHE=/var/tmp/contab-node-win   # unde se ține runtime-ul Windows descărcat
