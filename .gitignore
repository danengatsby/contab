node_modules/
data/
logs/
.env
.env.*
!.env.example
*.log
/tmp/

# fisiere de cookie lasate de curl in probele manuale (sesiuni, nu artefacte de proiect)
cookies*.txt
*.cookies
c[0-9].txt
p[0-9].txt

# Setarile LOCALE ale editorului (Claude Code). Nu se comit — dar fara linia asta, `git status`
# le vede ca netracate, iar garda din src/deployState.js raporta „arbore murdar" la fiecare
# pornire in productie. O alarma care suna mereu e o alarma pe care operatorul o ignora.
# (Root le ascundea printr-un core.excludesFile global, utilizatorul `contab` nu — deci
# verdictul difera dupa cine il cere. Aici il facem sa nu mai depinda de asta.)
.claude/settings.local.json

# Pachete de descarcat servite temporar (ex. pachetul Windows). NU se comit: sunt artefacte
# mari, generate. Fara linia asta, garda din src/deployState.js ar raporta „arbore murdar"
# la fiecare pornire — exact alarma care suna mereu si pe care operatorul o ignora.
/public/descarcari/
# site-ul cartii — generat integral de `npm run cuprins-carte`, ca si descarcarile
/public/carte/

# Pachete locale de distribuție (pot include arhive criptate și nu sunt surse versionate).
/dist/

# Videoul de prezentare si cadrele lui: artefacte GENERATE (zeci de MB), reproductibile cu
# scripts/video-prezentare.mjs. Nu se comit — dar fara linia asta ar fi raportate ca „arbore
# murdar" de garda din src/deployState.js la fiecare pornire in productie.
/marketing/video/
