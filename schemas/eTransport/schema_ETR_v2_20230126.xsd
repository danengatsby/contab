			</xs:restriction>
		</xs:complexContent>
	</xs:complexType>

	<!-- elementul notificare -->
	<xs:complexType name="NotificareType">
		<xs:sequence>
			<xs:element name="corectie" type="CorectieType" minOccurs="0" maxOccurs="1"/>
			<xs:element name="bunuriTransportate" type="BunuriTransportateType" minOccurs="1"
